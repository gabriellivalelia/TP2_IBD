        "id": "BhjKBOsUMsyH"
      },
      "source": [
        "### Consulta 10: Quais agentes concentram os maiores valores históricos de receita associados às obras?\n",
        "\n",
        "Junta `Agente`, `Contrato`, `Empreendimento` e `Obra` com funções de agregação (`SUM`, `AVG`, `COUNT` e `GROUP BY`) para consolidar o valor histórico de receita (`VlrHisRct`) associado às obras de cada concessionária de transmissão."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "sql = \"\"\"\n",
        "SELECT a.IdAgente AS \"ID do agente\",\n",
        "       a.DscRazaoSocial AS \"Agente\",\n",
        "       a.SigUF AS \"UF\",\n",
        "       COUNT(DISTINCT c.IdeCcd) AS \"Contratos\",\n",
        "       COUNT(DISTINCT e.IdeEpd) AS \"Empreendimentos\",\n",
        "       COUNT(o.IdeObr) AS \"Total de obras\",\n",
        "       ROUND(SUM(COALESCE(o.VlrHisRct, 0)) / 1e6, 2) AS \"Receita histórica total (R$ milhões)\",\n",
        "       ROUND(AVG(o.VlrHisRct) / 1e6, 2) AS \"Receita média por obra (R$ milhões)\"\n",
        "FROM Agente AS a\n",
        "JOIN Contrato AS c ON c.IdAgente = a.IdAgente\n",
        "JOIN Empreendimento AS e ON e.IdeCcd = c.IdeCcd\n",
        "JOIN Obra AS o ON o.IdeEpd = e.IdeEpd\n",
        "GROUP BY a.IdAgente, a.DscRazaoSocial, a.SigUF\n",
        "ORDER BY \"Receita histórica total (R$ milhões)\" DESC, \"Total de obras\" DESC;\n",
        "\"\"\"\n",
        "resultado_10 = consultar(sql)\n",
        "\n",
        "print(f\"Total de agentes com obras vinculadas: {len(resultado_10)} | Amostra: Top 10 por receita histórica\")\n",
        "with pd.option_context(\"display.max_colwidth\", None):\n",
        "    display(resultado_10.head(10))\n",
        "\n",
        "# Cálculo de participação percentual sobre a receita total da base\n",
        "col_receita = \"Receita histórica total (R$ milhões)\"\n",
        "receita_global = resultado_10[col_receita].sum()\n",
        "top10_receita = resultado_10.head(10).copy()\n",
        "top10_receita[\"Participação (%)\"] = (100 * top10_receita[col_receita] / receita_global).round(2)\n",
        "\n",
        "concentracao_top5 = 100 * resultado_10.head(5)[col_receita].sum() / receita_global\n",
        "concentracao_top10 = 100 * resultado_10.head(10)[col_receita].sum() / receita_global\n",
        "\n",
        "print(f\"Receita histórica total acumulada nas obras: R$ {receita_global:,.2f} milhões\")\n",
        "print(f\"Concentração nos 5 maiores agentes: {concentracao_top5:.1f}% da receita total\")\n",
        "print(f\"Concentração nos 10 maiores agentes: {concentracao_top10:.1f}% da receita total\")\n",
        "display(top10_receita[[\"ID do agente\", \"Agente\", \"UF\", \"Contratos\", \"Total de obras\", col_receita, \"Participação (%)\"]])\n",
        "\n",
        "serie_top10 = resultado_10.head(10).set_index(\"Agente\")[col_receita].round(1)\n",
        "grafico_barras(serie_top10, \"Top 10 agentes por receita histórica acumulada nas obras (em R$ milhões)\")"
      ],
