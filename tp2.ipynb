        "sql = \"\"\"\n",
        "SELECT IdeEpd AS \"ID\",\n",
        "       NomEpd AS \"Empreendimento\",\n",
        "       DscSituacaoEpd AS \"Situação\"\n",
        "FROM Empreendimento\n",
        "WHERE DscSituacaoEpd = 'Em andamento'\n",
        "ORDER BY NomEpd, IdeEpd;\n",
        "\"\"\"\n",
        "resultado_2 = consultar(sql)\n",
        "\n",
        "print(f\"Total de registros: {len(resultado_2)} | Amostra: até 8 linhas\")\n",
