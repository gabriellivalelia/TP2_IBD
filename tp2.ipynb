      "source": [
        "### Consulta 6: Quais empreendimentos estão vinculados a cada agente e contrato?\n",
        "\n",
        "Junta `Agente`, `Contrato` e `Empreendimento` pelos identificadores `IdAgente` e `IdeCcd` para relacionar cada empreendimento de expansão ao seu contrato de concessão e ao respectivo agente transmissor responsável."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "sql = \"\"\"\n",
        "SELECT a.IdAgente AS \"ID do agente\",\n",
        "       a.DscRazaoSocial AS \"Agente\",\n",
        "       c.IdeCcd AS \"ID do contrato\",\n",
        "       c.NumCnaCcd AS \"Nº do contrato\",\n",
        "       e.IdeEpd AS \"ID do empreendimento\",\n",
        "       e.NomEpd AS \"Empreendimento\",\n",
        "       e.DscSituacaoEpd AS \"Situação\"\n",
        "FROM Agente AS a\n",
        "JOIN Contrato AS c ON c.IdAgente = a.IdAgente\n",
        "JOIN Empreendimento AS e ON e.IdeCcd = c.IdeCcd\n",
        "ORDER BY a.DscRazaoSocial, c.IdeCcd, e.IdeEpd;\n",
        "\"\"\"\n",
        "resultado_6 = consultar(sql)\n",
        "\n",
        "print(f\"Total de registros: {len(resultado_6)} | Amostra: até 8 linhas\")\n",
        "with pd.option_context(\"display.max_colwidth\", None):\n",
        "    display(resultado_6.head(8))\n",
        "\n",
        "# Resumo da distribuição por situação e por agente\n",
        "contagem_situacao = resultado_6[\"Situação\"].value_counts()\n",
        "resumo_situacao = contagem_situacao.rename_axis(\"Situação\").reset_index(name=\"Empreendimentos\")\n",
        "resumo_situacao[\"Percentual (%)\"] = (100 * resumo_situacao[\"Empreendimentos\"] / len(resultado_6)).round(1)\n",
        "\n",
        "emp_por_agente = (\n",
        "    resultado_6.groupby([\"ID do agente\", \"Agente\"])\n",
        "    .agg(\n",
        "        Contratos=(\"ID do contrato\", \"nunique\"),\n",
        "        Empreendimentos=(\"ID do empreendimento\", \"count\")\n",
        "    )\n",
        "    .sort_values(\"Empreendimentos\", ascending=False)\n",
        ")\n",
        "\n",
        "print(f\"Agentes com empreendimentos vinculados: {len(emp_por_agente)} de {len(TABELAS['Agente'])}\")\n",
        "print(f\"Contratos com empreendimentos vinculados: {resultado_6['ID do contrato'].nunique()} de {len(TABELAS['Contrato'])}\")\n",
        "display(resumo_situacao)\n",
        "print(\"Cinco agentes com maior número de empreendimentos:\")\n",
        "display(emp_por_agente.head(5).reset_index())\n",
        "grafico_barras(contagem_situacao, \"Empreendimentos por situação cadastral\")"
      ],
