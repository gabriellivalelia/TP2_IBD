      "source": [
        "import pandas as pd\n",
        "import sqlite3, re\n",
        "from pathlib import Path\n",
        "from collections import defaultdict\n",
        "\n",
        "# Arquivos de entrada: cada chave identifica o conjunto de dados usado no processamento.\n",
        "ARQUIVOS = {\n",
        "    \"agente\": \"siget-contrato-agente.csv\",\n",
        "    \"central\": \"siget-contrato-empreendimento-obra-modulo.csv\",\n",
        "    \"linha\": \"siget-contrato-modulolinhatransmissao-subestacaoorigem-subestacaodestino.csv\",\n",
        "    \"equip\": \"siget-contrato-moduloequipamento-subestacao.csv\",\n",
        "    \"manobra\": \"siget-contrato-modulomanobra-subestacao-tipoarranjo.csv\",\n",
        "}\n",
        "# Diretórios de entrada e saída do processamento.\n",
        "BASE = Path(\"data\")\n",
        "SAIDA = Path(\"resultado_siget\")\n",
        "SAIDA.mkdir(exist_ok=True)\n",
        "DB = SAIDA / \"siget_normalizado.db\"\n",
        "# `logs` resume as etapas; `rejeicoes` armazena os registros removidos.\n",
        "logs = []\n",
        "rejeicoes = []\n",
        "\n",
        "\n",
        "# Registra a quantidade de linhas afetadas em cada etapa para a auditoria.\n",
        "def log(etapa, tabela, motivo, quantidade):\n",
        "    logs.append(\n",
        "        {\n",
        "            \"etapa\": etapa,\n",
        "            \"tabela\": tabela,\n",
        "            \"motivo\": motivo,\n",
        "            \"quantidade\": int(quantidade),\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "# Lê um CSV e padroniza os nomes e os valores textuais antes da limpeza.\n",
        "def carregar(arq):\n",
        "    d = pd.read_csv(\n",
        "        BASE / arq, sep=\";\", encoding=\"latin1\", dtype=\"string\", low_memory=False\n",
        "    )\n",
        "    # Remove espaços dos nomes das colunas e transforma valores vazios em NA.\n",
        "    d.columns = d.columns.str.strip()\n",
        "    for c in d:\n",
        "        d[c] = (\n",
        "            d[c]\n",
        "            .str.strip()\n",
        "            .replace({\"\": pd.NA, \"nan\": pd.NA, \"null\": pd.NA, \"NULL\": pd.NA})\n",
        "        )\n",
        "    return d\n",
        "\n",
        "\n",
        "# Carrega todos os arquivos em DataFrames independentes, sem alterar os CSVs.\n",
        "D = {k: carregar(f) for k, f in ARQUIVOS.items()}\n",
        "for k, v in D.items():\n",
        "    print(f\"{k:8s} {len(v):>7,} registros, {len(v.columns)} colunas\")\n",
        "\n",
        "\n",
        "# Guarda os registros rejeitados e os inclui no relatório de auditoria.\n",
        "def registrar_rejeicao(tabela, motivo, df):\n",
        "    if len(df):\n",
        "        rej = df.copy()\n",
        "        rej.insert(0, \"motivo\", motivo)\n",
        "        rejeicoes.append((tabela, motivo, rej))\n",
        "        log(\"rejeicao\", tabela, motivo, len(rej))\n",
        "\n",
        "\n",
        "def extrair(df, tabela, chave, cols, obrigatorias=()):\n",
        "    \"\"\"Cria uma relação com uma linha por chave e valida seus atributos.\"\"\"\n",
        "    cols = [x for x in dict.fromkeys([chave] + list(cols)) if x in df.columns]\n",
        "    base = df[cols].copy()\n",
        "    # Uma chave ausente impede a identificação da entidade e causa rejeição.\n",
        "    invalid = base[chave].isna()\n",
        "    registrar_rejeicao(tabela, \"chave primária ausente\", base.loc[invalid])\n",
        "    base = base.loc[~invalid]\n",
        "    # A mesma chave não pode possuir valores diferentes para um mesmo atributo.\n",
        "    conflitos = set()\n",
        "    for c in cols:\n",
        "        if c == chave:\n",
        "            continue\n",
        "        n = base.groupby(chave, dropna=False)[c].nunique(dropna=True)\n",
        "        conflitos.update(n[n > 1].index.astype(str).tolist())\n",
        "    if conflitos:\n",
        "        registrar_rejeicao(\n",
        "            tabela,\n",
        "            \"atributos conflitantes para a mesma chave\",\n",
        "            base[base[chave].isin(conflitos)],\n",
        "        )\n",
        "        base = base[~base[chave].isin(conflitos)]\n",
        "\n",
        "    # O agrupamento combina registros complementares, preservando valores não nulos.\n",
        "    def primeiro(s):\n",
        "        s = s.dropna()\n",
        "        return s.iloc[0] if len(s) else None\n",
        "\n",
        "    tab = base.groupby(chave, as_index=False, dropna=False).first()\n",
        "    # Remove entidades que ainda não possuem algum atributo obrigatório.\n",
        "    for c in obrigatorias:\n",
        "        if c in tab:\n",
        "            bad = tab[c].isna()\n",
        "            registrar_rejeicao(tabela, f\"{c} obrigatório ausente\", tab[bad])\n",
        "            tab = tab[~bad]\n",
        "    log(\"extracao\", tabela, \"linhas criadas\", len(tab))\n",
        "    return tab.reset_index(drop=True)\n",
        "\n",
        "\n",
        "# Mantém somente registros cuja chave estrangeira existe na relação pai.\n",
        "def filtrar_fk(df, tabela, fk, pais, pk):\n",
        "    good = df[fk].isin(set(pais[pk].dropna())) & df[fk].notna()\n",
        "    registrar_rejeicao(tabela, f\"FK {fk} sem correspondente em {pk}\", df[~good])\n",
        "    return df[good].reset_index(drop=True)\n",
        "\n",
        "\n",
        "# Cria cópias de trabalho para preservar os dados originais.\n",
        "A = D[\"agente\"].copy()\n",
        "C = D[\"central\"].copy()\n",
        "L = D[\"linha\"].copy()\n",
        "E = D[\"equip\"].copy()\n",
        "M = D[\"manobra\"].copy()\n",
        "\n",
        "# Limpeza estrita: registros inválidos são excluídos, em vez de mantidos com FK nula.\n",
        "# As remoções ocorrem somente nos DataFrames em memória; os CSVs não são alterados.\n",
        "sem_agente = A[\"IdAgente\"].isna()\n",
        "registrar_rejeicao(\n",
        "    \"Contrato\", \"Contrato excluído por IdAgente ausente\", A.loc[sem_agente]\n",
        ")\n",
        "A = A.loc[~sem_agente].copy()\n",
        "agente = extrair(\n",
        "    A,\n",
        "    \"Agente\",\n",
        "    \"IdAgente\",\n",
        "    [\n",
        "        \"NumCNPJ\",\n",
        "        \"DscRazaoSocial\",\n",
        "        \"NumCEPAgente\",\n",
        "        \"SigUF\",\n",
        "        \"NomMunicipio\",\n",
        "        \"NomBairroAgente\",\n",
        "        \"DscEnderecoAgente\",\n",
        "    ],\n",
        ")\n",
        "contrato = extrair(\n",
        "    A,\n",
        "    \"Contrato\",\n",
        "    \"IdeCcd\",\n",
        "    [\"IdAgente\", \"IdcTipoCcd\", \"NumCnaCcd\", \"DatAsnCcd\", \"DatFimCcd\"],\n",
        "    [\"IdAgente\"],\n",
        ")\n",
        "contrato = filtrar_fk(contrato, \"Contrato\", \"IdAgente\", agente, \"IdAgente\")\n",
        "# O campo tarifário vem do arquivo central e é incorporado à relação Contrato.\n",
        "# Antes da junção, verifica-se se IdeCcd determina um único IdeCcoTarReceita.\n",
        "# A data DatFimCcd permanece no cadastro de contratos, pois pode variar no arquivo central.\n",
        "tar = C[[\"IdeCcd\", \"IdeCcoTarReceita\"]].dropna(subset=[\"IdeCcd\"]).copy()\n",
        "conflitos_tar = tar.groupby(\"IdeCcd\")[\"IdeCcoTarReceita\"].nunique(dropna=True)\n",
        "if (conflitos_tar > 1).any():\n",
        "    raise ValueError(\"IdeCcoTarReceita não é funcionalmente dependente de IdeCcd!\")\n",
        "tar = tar.dropna(subset=[\"IdeCcoTarReceita\"]).drop_duplicates(\"IdeCcd\")\n",
        "contrato = contrato.merge(tar, on=\"IdeCcd\", how=\"left\", validate=\"one_to_one\")\n",
        "# Valida as referências a contratos proprietários no arquivo central.\n",
        "# Um valor nulo não é rejeitado; somente uma referência preenchida e inexistente é inválida.\n",
        "ids_contratos = set(contrato[\"IdeCcd\"].dropna())\n",
        "if \"IdeCcdProprietario\" not in C.columns:\n",
        "    raise KeyError(\n",
        "        \"Arquivo central sem IdeCcdProprietario; não é seguro ignorar a validação.\"\n",
        "    )\n",
        "sem_proprietario = C[\"IdeCcdProprietario\"].notna() & ~C[\"IdeCcdProprietario\"].isin(\n",
        "    ids_contratos\n",
        ")\n",
        "registrar_rejeicao(\n",
        "    \"Central\",\n",
        "    \"IdeCcdProprietario não encontrado: linha removida\",\n",
        "    C.loc[sem_proprietario],\n",
        ")\n",
        "ids_proprietarios_ausentes = sorted(set(C.loc[sem_proprietario, \"IdeCcdProprietario\"]))\n",
        "pd.DataFrame({\"IdeCcdProprietario_nao_encontrado\": ids_proprietarios_ausentes}).to_csv(\n",
        "    SAIDA / \"contratos_proprietarios_ausentes.csv\", index=False\n",
        ")\n",
        "C = C.loc[~sem_proprietario].copy()\n",
        "# Remove as linhas sem contrato principal válido, inclusive as afetadas pela\n",
        "# exclusão anterior de agentes sem identificador.\n",
        "sem_contrato = C[\"IdeCcd\"].isna() | ~C[\"IdeCcd\"].isin(ids_contratos)\n",
        "registrar_rejeicao(\n",
        "    \"Central\", \"IdeCcd sem contrato válido: linha removida\", C.loc[sem_contrato]\n",
        ")\n",
        "C = C.loc[~sem_contrato].copy()\n",
        "empreendimento = extrair(\n",
        "    C,\n",
        "    \"Empreendimento\",\n",
        "    \"IdeEpd\",\n",
        "    [\n",
        "        \"IdeCcd\",\n",
        "        \"IdeOnsEpd\",\n",
        "        \"NomEpd\",\n",
        "        \"DscEpd\",\n",
        "        \"DscSituacaoEpd\",\n",
        "        \"DatCaoCgmAtoLgl\",\n",
        "        \"DatOprComEpd\",\n",
        "        \"DatEfeOprComEpd\",\n",
        "    ],\n",
        "    [\"IdeCcd\"],\n",
        ")\n",
        "empreendimento = filtrar_fk(\n",
        "    empreendimento, \"Empreendimento\", \"IdeCcd\", contrato, \"IdeCcd\"\n",
        ")\n",
        "modulo = extrair(\n",
        "    C,\n",
        "    \"Modulo\",\n",
        "    \"IdeMdl\",\n",
        "    [\n",
        "        \"IdeOnsMdl\",\n",
        "        \"NomMdl\",\n",
        "        \"DscMdl\",\n",
        "        \"IdeTipMdl\",\n",
        "        \"DscSituacaoModulo\",\n",
        "        \"DscTipMdl\",\n",
        "        \"SigTipMdl\",\n",
        "        \"DscClfMdl\",\n",
        "        \"SglClfMdl\",\n",
        "        \"DscItmClfMdl\",\n",
        "    ],\n",
        ")\n",
        "obra = extrair(\n",
        "    C,\n",
        "    \"Obra\",\n",
        "    \"IdeObr\",\n",
        "    [\n",
        "        \"IdeEpd\",\n",
        "        \"IdeMdl\",\n",
        "        \"DscObr\",\n",
        "        \"DscSitObr\",\n",
        "        \"DscTipObr\",\n",
        "        \"NumVdaUtlMdl\",\n",
        "        \"VlrHisRct\",\n",
        "        \"DatOprComObr\",\n",
        "    ],\n",
        "    [\"IdeEpd\", \"IdeMdl\"],\n",
        ")\n",
        "obra = filtrar_fk(obra, \"Obra\", \"IdeEpd\", empreendimento, \"IdeEpd\")\n",
        "obra = filtrar_fk(obra, \"Obra\", \"IdeMdl\", modulo, \"IdeMdl\")\n",
        "# Remove módulos e empreendimentos que ficaram sem obras após as validações.\n",
        "# Assim, nenhuma entidade dependente permanece órfã no banco normalizado.\n",
        "modulo = modulo.loc[modulo[\"IdeMdl\"].isin(set(obra[\"IdeMdl\"]))].reset_index(drop=True)\n",
        "empreendimento = empreendimento.loc[\n",
        "    empreendimento[\"IdeEpd\"].isin(set(obra[\"IdeEpd\"]))\n",
        "].reset_index(drop=True)\n",
        "# Os arquivos especializados só podem conservar linhas associadas a módulos válidos.\n",
        "mods = set(modulo[\"IdeMdl\"])\n",
        "for nome, df in [(\"Linha\", L), (\"Equipamento\", E), (\"Manobra\", M)]:\n",
        "    invalidos = df[\"IdeMdl\"].isna() | ~df[\"IdeMdl\"].isin(mods)\n",
        "    registrar_rejeicao(\n",
        "        nome, \"Módulo sem obra válida: linha removida\", df.loc[invalidos]\n",
        "    )\n",
        "    if nome == \"Linha\":\n",
        "        L = df.loc[~invalidos].copy()\n",
        "    if nome == \"Equipamento\":\n",
        "        E = df.loc[~invalidos].copy()\n",
        "    if nome == \"Manobra\":\n",
        "        M = df.loc[~invalidos].copy()\n",
        "\n",
        "\n",
        "# Subestações: rejeita integralmente identificadores com atributos contraditórios.\n",
        "# A mesma subestação pode aparecer em diferentes arquivos, mas seus dados cadastrais\n",
        "# precisam ser consistentes. Não é escolhido um valor arbitrário por maioria.\n",
        "# Reúne as quatro formas de referência a subestações em uma estrutura única.\n",
        "def reunir_subestacoes(L, E, M):\n",
        "    partes = []\n",
        "    for df, ident, ons, nom, longo, uf in [\n",
        "        (\n",
        "            L,\n",
        "            \"IdeSbeOri\",\n",
        "            \"IdeOnsSbeOrigem\",\n",
        "            \"NomSubestacaoOrigem\",\n",
        "            \"NomLongoSubestacaoOrigem\",\n",
        "            \"SigUFSubestacaoOrigem\",\n",
        "        ),\n",
        "        (\n",
        "            L,\n",
        "            \"IdeSbeDsn\",\n",
        "            \"IdeOnsSbeDestino\",\n",
        "            \"NomSubestacaoDestino\",\n",
        "            \"NomLongoSubestacaoDestino\",\n",
        "            \"SigUFSubestacaoDestino\",\n",
        "        ),\n",
        "        (\n",
        "            E,\n",
        "            \"IdeSbe\",\n",
        "            \"IdeOnsSbe\",\n",
        "            \"NomSubestacao\",\n",
        "            \"NomLongoSubestacao\",\n",
        "            \"SigUFSubestacao\",\n",
        "        ),\n",
        "        (\n",
        "            M,\n",
        "            \"IdeSbe\",\n",
        "            \"IdeOnsSbe\",\n",
        "            \"NomSubestacao\",\n",
        "            \"NomLongoSubestacao\",\n",
        "            \"SigUFSubestacao\",\n",
        "        ),\n",
        "    ]:\n",
        "        temp = df[[ident, ons, nom, longo, uf]].copy()\n",
        "        temp.columns = [\n",
        "            \"IdeSbe\",\n",
        "            \"IdeOnsSbe\",\n",
        "            \"NomSubestacao\",\n",
        "            \"NomLongoSubestacao\",\n",
        "            \"SigUFSubestacao\",\n",
        "        ]\n",
        "        partes.append(temp)\n",
        "    return pd.concat(partes, ignore_index=True).dropna(subset=[\"IdeSbe\"])\n",
        "\n",
        "\n",
        "# Identifica atributos que assumem mais de um valor para o mesmo identificador.\n",
        "sub_raw = reunir_subestacoes(L, E, M)\n",
        "atributos_sub = [\"IdeOnsSbe\", \"NomSubestacao\", \"NomLongoSubestacao\", \"SigUFSubestacao\"]\n",
        "conflitantes = set()\n",
        "for campo in atributos_sub:\n",
        "    q = sub_raw.groupby(\"IdeSbe\")[campo].nunique(dropna=True)\n",
        "    conflitantes.update(q[q > 1].index.tolist())\n",
        "if conflitantes:\n",
        "    registrar_rejeicao(\n",
        "        \"Subestacao\",\n",
        "        \"Identificadores com atributos contraditórios; excluídos\",\n",
        "        sub_raw.loc[sub_raw.IdeSbe.isin(conflitantes)].drop_duplicates(),\n",
        "    )\n",
        "    registrar_rejeicao(\n",
        "        \"Linha\",\n",
        "        \"Terminal vinculado a subestação inconsistente; excluído\",\n",
        "        L.loc[L.IdeSbeOri.isin(conflitantes) | L.IdeSbeDsn.isin(conflitantes)],\n",
        "    )\n",
        "    L = L.loc[~(L.IdeSbeOri.isin(conflitantes) | L.IdeSbeDsn.isin(conflitantes))].copy()\n",
        "    registrar_rejeicao(\n",
        "        \"Equipamento\",\n",
        "        \"Subestação inconsistente; registro excluído\",\n",
        "        E.loc[E.IdeSbe.isin(conflitantes)],\n",
        "    )\n",
        "    E = E.loc[~E.IdeSbe.isin(conflitantes)].copy()\n",
        "    registrar_rejeicao(\n",
        "        \"Manobra\",\n",
        "        \"Subestação inconsistente; registro excluído\",\n",
        "        M.loc[M.IdeSbe.isin(conflitantes)],\n",
        "    )\n",
        "    M = M.loc[~M.IdeSbe.isin(conflitantes)].copy()\n",
        "    log(\n",
        "        \"limpeza\",\n",
        "        \"Subestacao\",\n",
        "        \"identificadores de subestação excluídos\",\n",
        "        len(conflitantes),\n",
        "    )\n",
        "# Recalcula a base após as exclusões e confirma que nenhuma divergência permaneceu.\n",
        "sub_raw = reunir_subestacoes(L, E, M)\n",
        "for campo in atributos_sub:\n",
        "    q = sub_raw.groupby(\"IdeSbe\")[campo].nunique(dropna=True)\n",
        "    assert not (q > 1).any(), f\"Divergências remanescentes: {campo}\"\n",
        "\n",
        "\n",
        "def primeiro_nao_nulo(s):\n",
        "    s = s.dropna()\n",
        "    return s.iloc[0] if len(s) else None\n",
        "\n",
        "\n",
        "subestacao = sub_raw.groupby(\"IdeSbe\", as_index=False).agg(\n",
        "    {c: primeiro_nao_nulo for c in atributos_sub}\n",
        ")\n",
        "log(\"extracao\", \"Subestacao\", \"linhas válidas criadas\", len(subestacao))\n",
        "linha = extrair(\n",
        "    L,\n",
        "    \"LinhaTransmissao\",\n",
        "    \"IdeLinTms\",\n",
        "    [\"NomLinTms\", \"DscSitLinTms\", \"NumTensaoBaseLinhaTransm\"],\n",
        ")\n",
        "modulo_linha = extrair(\n",
        "    L,\n",
        "    \"ModuloLinha\",\n",
        "    \"IdeMdl\",\n",
        "    [\"IdeLinTms\", \"NumCcuLinTms\", \"QtdTorLinTms\", \"NumEtnLinTms\"],\n",
        ")\n",
        "modulo_linha = filtrar_fk(modulo_linha, \"ModuloLinha\", \"IdeMdl\", modulo, \"IdeMdl\")\n",
        "modulo_linha = filtrar_fk(modulo_linha, \"ModuloLinha\", \"IdeLinTms\", linha, \"IdeLinTms\")\n",
        "modulo_equip = extrair(\n",
        "    E,\n",
        "    \"ModuloEquipamento\",\n",
        "    \"IdeMdl\",\n",
        "    [\n",
        "        \"IdeSbe\",\n",
        "        \"DscTipEqp\",\n",
        "        \"NumFasMdlEqp\",\n",
        "        \"MdaPotAtvMdlEqp\",\n",
        "        \"MdaTnsScdMdlEqp\",\n",
        "        \"MdaTnsTiaMdlEqp\",\n",
        "        \"DscFinMdlEqp\",\n",
        "        \"MdaCpeRaiNegMdlEqp\",\n",
        "        \"MdaCpeRaivPosMdlEqp\",\n",
        "        \"DscIdcExsMdlCnr\",\n",
        "    ],\n",
        ")\n",
        "modulo_equip = filtrar_fk(modulo_equip, \"ModuloEquipamento\", \"IdeMdl\", modulo, \"IdeMdl\")\n",
        "modulo_equip = filtrar_fk(\n",
        "    modulo_equip, \"ModuloEquipamento\", \"IdeSbe\", subestacao, \"IdeSbe\"\n",
        ")\n",
        "modulo_manobra = extrair(\n",
        "    M,\n",
        "    \"ModuloManobra\",\n",
        "    \"IdeMdl\",\n",
        "    [\n",
        "        \"IdeSbe\",\n",
        "        \"IdeTipAnjManobra\",\n",
        "        \"IdcTipMdlMno\",\n",
        "        \"IdeTipAnj\",\n",
        "        \"SglTipAnj\",\n",
        "        \"DscTipAnj\",\n",
        "        \"DscMdlMno\",\n",
        "        \"QtdDijMdlMno\",\n",
        "        \"QtdChvSccMdlMno\",\n",
        "    ],\n",
        ")\n",
        "modulo_manobra = filtrar_fk(modulo_manobra, \"ModuloManobra\", \"IdeMdl\", modulo, \"IdeMdl\")\n",
        "modulo_manobra = filtrar_fk(\n",
        "    modulo_manobra, \"ModuloManobra\", \"IdeSbe\", subestacao, \"IdeSbe\"\n",
        ")\n",
        "# Monta a relação N:M entre linhas e subestações, distinguindo origem e destino.\n",
        "# A deduplicação é necessária porque uma linha pode aparecer em vários módulos.\n",
        "ori = L[[\"IdeLinTms\", \"IdeSbeOri\"]].rename(columns={\"IdeSbeOri\": \"IdeSbe\"}).copy()\n",
        "ori[\"Papel\"] = \"Origem\"\n",
        "dst = L[[\"IdeLinTms\", \"IdeSbeDsn\"]].rename(columns={\"IdeSbeDsn\": \"IdeSbe\"}).copy()\n",
        "dst[\"Papel\"] = \"Destino\"\n",
        "linha_sub = pd.concat([ori, dst], ignore_index=True).drop_duplicates()\n",
        "chave_dupla = linha_sub.groupby([\"IdeLinTms\", \"Papel\"], dropna=False)[\"IdeSbe\"].nunique(\n",
        "    dropna=True\n",
        ")\n",
        "problematicas = chave_dupla[chave_dupla > 1].index\n",
        "if len(problematicas):\n",
        "    ids = set(x[0] for x in problematicas)\n",
        "    registrar_rejeicao(\n",
        "        \"LinhaSubestacao\",\n",
        "        \"mais de uma subestação para o mesmo papel\",\n",
        "        linha_sub[linha_sub.IdeLinTms.isin(ids)],\n",
        "    )\n",
        "    linha_sub = linha_sub[~linha_sub.IdeLinTms.isin(ids)]\n",
        "linha_sub = filtrar_fk(linha_sub, \"LinhaSubestacao\", \"IdeLinTms\", linha, \"IdeLinTms\")\n",
        "linha_sub = filtrar_fk(linha_sub, \"LinhaSubestacao\", \"IdeSbe\", subestacao, \"IdeSbe\")\n",
        "# Mantém somente linhas com dois terminais distintos: uma origem e um destino.\n",
        "n_term = linha_sub.groupby(\"IdeLinTms\")[\"IdeSbe\"].nunique()\n",
        "curtos = set(n_term[n_term < 2].index)\n",
        "if curtos:\n",
        "    registrar_rejeicao(\n",
        "        \"LinhaSubestacao\",\n",
        "        \"terminais não distintos ou incompletos\",\n",
        "        linha_sub[linha_sub.IdeLinTms.isin(curtos)],\n",
        "    )\n",
        "    linha_sub = linha_sub[~linha_sub.IdeLinTms.isin(curtos)]\n",
        "# Reúne as relações prontas para conversão de tipos e inserção no SQLite.\n",
        "TABELAS = {\n",
        "    \"Agente\": agente,\n",
        "    \"Contrato\": contrato,\n",
        "    \"Empreendimento\": empreendimento,\n",
        "    \"Modulo\": modulo,\n",
        "    \"Obra\": obra,\n",
        "    \"Subestacao\": subestacao,\n",
        "    \"LinhaTransmissao\": linha,\n",
        "    \"ModuloLinha\": modulo_linha,\n",
        "    \"ModuloEquipamento\": modulo_equip,\n",
        "    \"ModuloManobra\": modulo_manobra,\n",
        "    \"LinhaSubestacao\": linha_sub,\n",
        "}\n",
        "\n",
        "\n",
        "# Converte números e datas para os tipos aceitos pelo SQLite.\n",
        "# Valores inválidos tornam-se NULL e são registrados na auditoria.\n",
        "def numero(s, inteiro=False):\n",
        "    src = s.astype(\"string\").str.strip().replace({\"\": pd.NA})\n",
        "\n",
        "    # Aceita formatos brasileiros e valores que já estejam no padrão internacional.\n",
        "    def parse(v):\n",
        "        if pd.isna(v):\n",
        "            return None\n",
        "        v = str(v).strip().replace(\" \", \"\")\n",
        "        if \",\" in v:\n",
        "            v = v.replace(\".\", \"\").replace(\",\", \".\")\n",
        "        try:\n",
        "            n = float(v)\n",
        "            if not pd.notna(n):\n",
        "                return None\n",
        "            if inteiro and not n.is_integer():\n",
        "                return None\n",
        "            return int(n) if inteiro else n\n",
        "        except:\n",
        "            return None\n",
        "\n",
        "    return src.map(parse)\n",
        "\n",
        "\n",
        "NUMERICOS = {\n",
        "    \"Obra\": {\"NumVdaUtlMdl\": True, \"VlrHisRct\": False},\n",
        "    \"ModuloLinha\": {\"NumCcuLinTms\": True, \"QtdTorLinTms\": True, \"NumEtnLinTms\": False},\n",
        "    \"ModuloEquipamento\": {\n",
        "        \"MdaPotAtvMdlEqp\": False,\n",
        "        \"MdaTnsScdMdlEqp\": False,\n",
        "        \"MdaTnsTiaMdlEqp\": False,\n",
        "        \"MdaCpeRaiNegMdlEqp\": False,\n",
        "        \"MdaCpeRaivPosMdlEqp\": False,\n",
        "    },\n",
        "    \"ModuloManobra\": {\"QtdDijMdlMno\": True, \"QtdChvSccMdlMno\": True},\n",
        "    \"LinhaTransmissao\": {\"NumTensaoBaseLinhaTransm\": False},\n",
        "}\n",
        "DATAS = {\n",
        "    \"Contrato\": [\"DatAsnCcd\", \"DatFimCcd\"],\n",
        "    \"Empreendimento\": [\"DatCaoCgmAtoLgl\", \"DatOprComEpd\", \"DatEfeOprComEpd\"],\n",
        "    \"Obra\": [\"DatOprComObr\"],\n",
        "}\n",
        "# Aplica as conversões configuradas para cada relação e cada coluna.\n",
        "for nome, df in TABELAS.items():\n",
        "    for c, inteiro in NUMERICOS.get(nome, {}).items():\n",
        "        if c not in df:\n",
        "            continue\n",
        "        convertido = numero(df[c], inteiro)\n",
        "        inval = df[c].notna() & convertido.isna()\n",
        "        registrar_rejeicao(\n",
        "            nome,\n",
        "            f\"{c}: valor numérico inválido (atributo convertido para NULL)\",\n",
        "            df[inval],\n",
        "        )\n",
        "        df[c] = convertido\n",
        "    for c in DATAS.get(nome, []):\n",
        "        if c not in df:\n",
        "            continue\n",
        "        origem = df[c].copy()\n",
        "        parsed = pd.to_datetime(origem, dayfirst=True, format=\"mixed\", errors=\"coerce\")\n",
        "        inval = origem.notna() & parsed.isna()\n",
        "        registrar_rejeicao(\n",
        "            nome, f\"{c}: data inválida (atributo convertido para NULL)\", df[inval]\n",
        "        )\n",
        "        df[c] = parsed.dt.strftime(\"%Y-%m-%d\").astype(\"string\")\n",
        "# Define o esquema relacional, incluindo tipos, chaves e restrições de integridade.\n",
        "DDL = \"\"\"\n",
        "PRAGMA foreign_keys = ON;\n",
        "CREATE TABLE Agente (IdAgente TEXT PRIMARY KEY,NumCNPJ TEXT,DscRazaoSocial TEXT,NumCEPAgente TEXT,SigUF TEXT,NomMunicipio TEXT,NomBairroAgente TEXT,DscEnderecoAgente TEXT);\n",
        "CREATE TABLE Contrato (IdeCcd TEXT PRIMARY KEY,IdAgente TEXT,IdcTipoCcd TEXT,NumCnaCcd TEXT,DatAsnCcd TEXT,DatFimCcd TEXT,IdeCcoTarReceita TEXT,FOREIGN KEY(IdAgente) REFERENCES Agente(IdAgente));\n",
        "CREATE TABLE Empreendimento (IdeEpd TEXT PRIMARY KEY,IdeCcd TEXT NOT NULL,IdeOnsEpd TEXT,NomEpd TEXT,DscEpd TEXT,DscSituacaoEpd TEXT,DatCaoCgmAtoLgl TEXT,DatOprComEpd TEXT,DatEfeOprComEpd TEXT,FOREIGN KEY(IdeCcd) REFERENCES Contrato(IdeCcd));\n",
        "CREATE TABLE Modulo (IdeMdl TEXT PRIMARY KEY,IdeOnsMdl TEXT,NomMdl TEXT,DscMdl TEXT,IdeTipMdl TEXT,DscSituacaoModulo TEXT,DscTipMdl TEXT,SigTipMdl TEXT,DscClfMdl TEXT,SglClfMdl TEXT,DscItmClfMdl TEXT);\n",
        "CREATE TABLE Obra (IdeObr TEXT PRIMARY KEY,IdeEpd TEXT NOT NULL,IdeMdl TEXT NOT NULL,DscObr TEXT,DscSitObr TEXT,DscTipObr TEXT,NumVdaUtlMdl INTEGER,VlrHisRct REAL,DatOprComObr TEXT,FOREIGN KEY(IdeEpd) REFERENCES Empreendimento(IdeEpd),FOREIGN KEY(IdeMdl) REFERENCES Modulo(IdeMdl));\n",
        "CREATE TABLE Subestacao (IdeSbe TEXT PRIMARY KEY,IdeOnsSbe TEXT,NomSubestacao TEXT,NomLongoSubestacao TEXT,SigUFSubestacao TEXT);\n",
        "CREATE TABLE LinhaTransmissao (IdeLinTms TEXT PRIMARY KEY,NomLinTms TEXT,DscSitLinTms TEXT,NumTensaoBaseLinhaTransm REAL);\n",
        "CREATE TABLE ModuloLinha (IdeMdl TEXT PRIMARY KEY,IdeLinTms TEXT NOT NULL,NumCcuLinTms INTEGER,QtdTorLinTms INTEGER,NumEtnLinTms REAL,FOREIGN KEY(IdeMdl) REFERENCES Modulo(IdeMdl),FOREIGN KEY(IdeLinTms) REFERENCES LinhaTransmissao(IdeLinTms));\n",
        "CREATE TABLE ModuloEquipamento (IdeMdl TEXT PRIMARY KEY,IdeSbe TEXT NOT NULL,DscTipEqp TEXT,NumFasMdlEqp TEXT,MdaPotAtvMdlEqp REAL,MdaTnsScdMdlEqp REAL,MdaTnsTiaMdlEqp REAL,DscFinMdlEqp TEXT,MdaCpeRaiNegMdlEqp REAL,MdaCpeRaivPosMdlEqp REAL,DscIdcExsMdlCnr TEXT CHECK (DscIdcExsMdlCnr IN ('S','N') OR DscIdcExsMdlCnr IS NULL),FOREIGN KEY(IdeMdl) REFERENCES Modulo(IdeMdl),FOREIGN KEY(IdeSbe) REFERENCES Subestacao(IdeSbe));\n",
        "CREATE TABLE ModuloManobra (IdeMdl TEXT PRIMARY KEY,IdeSbe TEXT NOT NULL,IdeTipAnjManobra TEXT,IdcTipMdlMno TEXT,IdeTipAnj TEXT,SglTipAnj TEXT,DscTipAnj TEXT,DscMdlMno TEXT,QtdDijMdlMno INTEGER,QtdChvSccMdlMno INTEGER,FOREIGN KEY(IdeMdl) REFERENCES Modulo(IdeMdl),FOREIGN KEY(IdeSbe) REFERENCES Subestacao(IdeSbe));\n",
        "CREATE TABLE LinhaSubestacao (IdeLinTms TEXT NOT NULL, IdeSbe TEXT NOT NULL, Papel TEXT NOT NULL CHECK (Papel IN ('Origem','Destino')), PRIMARY KEY(IdeLinTms,Papel), UNIQUE(IdeLinTms,IdeSbe),FOREIGN KEY(IdeLinTms) REFERENCES LinhaTransmissao(IdeLinTms),FOREIGN KEY(IdeSbe) REFERENCES Subestacao(IdeSbe));\n",
        "\"\"\"\n",
        "# Salva o esquema SQL para documentação e reprodução da estrutura do banco.\n",
        "(SAIDA / \"esquema.sql\").write_text(DDL, encoding=\"utf-8\")\n",
        "# Recria somente o banco de saída; os arquivos CSV de entrada não são modificados.\n",
        "if DB.exists():\n",
        "    DB.unlink()\n",
        "# Abre a conexão e cria as tabelas definidas no DDL.\n",
        "con = sqlite3.connect(DB)\n",
        "con.executescript(DDL)\n",
        "try:\n",
        "    for nome, df in TABELAS.items():\n",
        "        # O SQLite recebe None no lugar de NA/NaN, preservando os demais valores.\n",
        "        valores = [\n",
        "            tuple(None if pd.isna(x) else x for x in linha)\n",
        "            for linha in df.itertuples(index=False, name=None)\n",
        "        ]\n",
        "        # Monta uma instrução parametrizada com as colunas da relação atual.\n",
        "        cols = list(df.columns)\n",
        "        cmd = f'INSERT INTO \"{nome}\" ({\",\".join(chr(34) + c + chr(34) for c in cols)}) VALUES ({\",\".join([\"?\"] * len(cols))})'\n",
        "        try:\n",
        "            con.executemany(cmd, valores)\n",
        "        except Exception as exc:\n",
        "            raise RuntimeError(f\"Falha ao inserir em {nome}: {exc}\") from exc\n",
        "    # Verifica as chaves estrangeiras antes de confirmar a transação.\n",
        "    erros = con.execute(\"PRAGMA foreign_key_check\").fetchall()\n",
        "    assert not erros, f\"Falhas de FK: {erros[:10]}\"\n",
        "    con.commit()\n",
        "finally:\n",
        "    con.close()\n",
        "# Exporta os registros rejeitados e o resumo das decisões de limpeza.\n",
        "# Esses arquivos permitem rastrear por que cada registro foi removido ou convertido.\n",
        "# Arquivos de auditoria\n",
        "pd.DataFrame(logs).to_csv(SAIDA / \"auditoria.csv\", index=False, encoding=\"utf-8-sig\")\n",
        "for tabela, motivo, df in rejeicoes:\n",
        "    safe = re.sub(r\"[^a-z0-9]+\", \"_\", f\"{tabela}_{motivo}\".lower()).strip(\"_\")[:95]\n",
        "    df.to_csv(SAIDA / f\"revisar_{safe}.csv\", index=False, encoding=\"utf-8-sig\")\n",
        "print(\"\\nBANCO CRIADO:\", DB.resolve())\n",
        "for nome, df in TABELAS.items():\n",
        "    print(f\"  {nome:22s}: {len(df):>7,} registros\")\n",
        "print(\"Total de tuplas:\", sum(len(t) for t in TABELAS.values()))\n",
        "print(\"Integridade referencial: OK (PRAGMA foreign_key_check)\")\n",
        "print(\"Saídas:\", SAIDA.resolve())\n"
      ]
    },
