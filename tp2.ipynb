        "sql = \"\"\"\n",
        "SELECT s.IdeSbe AS \"ID da subestação\",\n",
        "       s.NomSubestacao AS \"Subestação\",\n",
        "       s.SigUFSubestacao AS \"UF\",\n",
        "       e.IdeMdl AS \"ID do módulo\",\n",
        "       e.DscTipEqp AS \"Tipo de equipamento\"\n",
        "FROM ModuloEquipamento AS e\n",
        "JOIN Subestacao AS s ON s.IdeSbe = e.IdeSbe\n",
        "ORDER BY s.NomSubestacao, s.IdeSbe, e.IdeMdl;\n",
        "\"\"\"\n",
        "resultado_5 = consultar(sql)\n",
        "\n",
        "print(f\"Total de registros: {len(resultado_5)} | Amostra: até 8 linhas\")\n",
        "with pd.option_context(\"display.max_colwidth\", None):\n",
        "    display(resultado_5.head(8))\n",
        "\n",
        "contagem_tipos = resultado_5[\"Tipo de equipamento\"].value_counts()\n",
        "resumo_tipos = contagem_tipos.rename_axis(\"Tipo de equipamento\").reset_index(name=\"Módulos\")\n",
        "resumo_tipos[\"Percentual (%)\"] = (100 * resumo_tipos[\"Módulos\"] / len(resultado_5)).round(1)\n",
        "print(f\"Tipos de equipamento: {len(contagem_tipos)}\")\n",
        "print(f\"Subestações distintas: {resultado_5['ID da subestação'].nunique()}\")\n",
        "print(f\"Três tipos mais frequentes: {contagem_tipos.head(3).sum()} módulos \"\n",
        "      f\"({100 * contagem_tipos.head(3).sum() / len(resultado_5):.1f}%)\")\n",
        "display(resumo_tipos)\n",
        "grafico_barras(contagem_tipos, \"Módulos cadastrados por tipo de equipamento\")\n"
      ]
    },
