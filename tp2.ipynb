        "      f\"({100 * len(resultado_2) / total_empreendimentos:.1f}%)\")\n",
        "# Procura o mesmo trecho em todos os nomes, sem diferenciar maiúsculas.\n",
        "menciona_substituicao = resultado_2[\"Empreendimento\"].str.contains(\"substitui\", case=False, regex=False, na=False)\n",
