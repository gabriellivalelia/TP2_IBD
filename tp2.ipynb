      "source": [
        "sql = \"\"\"\n",
        "SELECT a.IdAgente AS \"ID do agente\",\n",
        "       a.DscRazaoSocial AS \"Agente\",\n",
        "       c.IdeCcd AS \"ID do contrato\",\n",
        "       c.NumCnaCcd AS \"Nº do contrato\"\n",
        "FROM Agente AS a\n",
        "JOIN Contrato AS c ON c.IdAgente = a.IdAgente\n",
        "ORDER BY a.DscRazaoSocial, a.IdAgente, c.IdeCcd;\n",
        "\"\"\"\n",
        "resultado_3 = consultar(sql)\n",
        "\n",
        "print(f\"Total de registros: {len(resultado_3)} | Amostra: até 8 linhas\")\n",
        "with pd.option_context(\"display.max_colwidth\", None):\n",
        "    display(resultado_3.head(8))\n",
        "\n",
        "contratos_por_agente = resultado_3.groupby([\"ID do agente\", \"Agente\"]).size().sort_values(ascending=False)\n",
        "varios_contratos = contratos_por_agente[contratos_por_agente > 1]\n",
        "print(f\"Agentes distintos: {len(contratos_por_agente)}\")\n",
        "print(f\"Agentes com vários contratos: {len(varios_contratos)} \"\n",
        "      f\"({100 * len(varios_contratos) / len(contratos_por_agente):.1f}% dos agentes)\")\n",
        "print(f\"Contratos desses agentes: {varios_contratos.sum()} \"\n",
        "      f\"({100 * varios_contratos.sum() / len(resultado_3):.1f}% dos contratos)\")\n",
        "print(\"Cinco agentes com mais contratos cadastrados\")\n",
        "display(contratos_por_agente.head(5).reset_index(name=\"Contratos\"))\n"
      ]
    },
