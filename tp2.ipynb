      "source": [
        "from contextlib import closing\n",
        "from html import escape\n",
        "\n",
        "banco = DB.resolve().as_uri() + \"?mode=ro\"\n",
        "\n",
        "\n",
        "def corrigir_acentos(valor):\n",
        "    # Corrige textos UTF-8 lidos como Latin-1, preservando os demais valores.\n",
        "    if isinstance(valor, str):\n",
        "        try:\n",
        "            return valor.encode(\"latin1\").decode(\"utf-8\")\n",
        "        except (UnicodeEncodeError, UnicodeDecodeError):\n",
        "            return valor\n",
        "    return valor\n",
        "\n",
        "\n",
        "def consultar(sql):\n",
        "    with closing(sqlite3.connect(banco, uri=True)) as conexao:\n",
        "        return pd.read_sql_query(sql, conexao).map(corrigir_acentos)\n",
        "\n",
        "\n",
        "def grafico_barras(contagens, titulo):\n",
        "    linhas = []\n",
        "    for rotulo, quantidade in contagens.items():\n",
        "        largura = 100 * quantidade / contagens.max()\n",
        "        linhas.append(\n",
        "            \"<tr>\"\n",
        "            f\"<th scope='row' style='text-align:right'>{escape(str(rotulo))}</th>\"\n",
        "            f\"<td style='width:260px'><div style='height:14px;width:{largura:.1f}%;\"\n",
        "            \"background:#327b9f'></div></td>\"\n",
        "            f\"<td style='text-align:right'>{quantidade}</td>\"\n",
        "            \"</tr>\"\n",
        "        )\n",
        "    tabela = (\n",
        "        f\"<table><caption style='font-weight:bold'>{escape(titulo)}</caption>\"\n",
        "        \"<thead><tr><th>Categoria</th><th></th><th>Quantidade</th></tr></thead>\"\n",
        "        f\"<tbody>{''.join(linhas)}</tbody></table>\"\n",
        "    )\n",
        "    display({\"text/html\": tabela}, raw=True)\n",
        "\n",
        "\n",
        "sql = \"\"\"\n",
        "SELECT IdeLinTms AS \"ID da linha\",\n",
        "       NomLinTms AS \"Linha\",\n",
        "       NumTensaoBaseLinhaTransm AS \"Tensão (kV)\"\n",
        "FROM LinhaTransmissao\n",
        "WHERE NumTensaoBaseLinhaTransm >= 500\n",
        "ORDER BY NumTensaoBaseLinhaTransm DESC, NomLinTms, IdeLinTms;\n",
        "\"\"\"\n",
        "resultado_1 = consultar(sql)\n",
        "\n",
        "print(f\"Total de registros: {len(resultado_1)} | Amostra: até 8 linhas\")\n",
        "with pd.option_context(\"display.max_colwidth\", None):\n",
        "    display(resultado_1.head(8))\n",
        "\n",
        "# Resume todos os registros retornados, incluindo as linhas fora da amostra.\n",
        "contagem_tensao = resultado_1[\"Tensão (kV)\"].value_counts().sort_index()\n",
        "resumo_tensao = contagem_tensao.rename_axis(\"Tensão (kV)\").reset_index(name=\"Linhas\")\n",
        "resumo_tensao[\"Percentual (%)\"] = (100 * resumo_tensao[\"Linhas\"] / len(resultado_1)).round(1)\n",
        "total_linhas = len(TABELAS[\"LinhaTransmissao\"])\n",
        "print(f\"Linhas com pelo menos 500 kV: {len(resultado_1)} de {total_linhas} \"\n",
        "      f\"({100 * len(resultado_1) / total_linhas:.1f}%)\")\n",
        "display(resumo_tensao)\n",
        "contagem_tensao.index = [f\"{tensao:g} kV\" for tensao in contagem_tensao.index]\n",
        "grafico_barras(contagem_tensao, \"Linhas de transmissão por tensão-base\")\n"
      ]
    },
