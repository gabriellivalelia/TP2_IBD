      "source": [
        "sql = \"\"\"\n",
        "SELECT ls.IdeLinTms AS \"ID da linha\",\n",
        "       s.IdeSbe AS \"ID da subestação\",\n",
        "       s.NomSubestacao AS \"Subestação\",\n",
        "       s.SigUFSubestacao AS \"UF\",\n",
        "       ls.Papel\n",
        "FROM LinhaSubestacao AS ls\n",
        "JOIN Subestacao AS s ON s.IdeSbe = ls.IdeSbe\n",
        "ORDER BY ls.IdeLinTms, ls.Papel DESC;\n",
        "\"\"\"\n",
        "resultado_4 = consultar(sql)\n",
        "\n",
        "print(f\"Total de registros: {len(resultado_4)} | Amostra: até 8 linhas\")\n",
        "with pd.option_context(\"display.max_colwidth\", None):\n",
        "    display(resultado_4.head(8))\n",
        "\n",
        "# Compara as UFs dos dois terminais de cada linha pelo identificador.\n",
        "terminais_uf = resultado_4.pivot(index=\"ID da linha\", columns=\"Papel\", values=\"UF\")\n",
        "terminais_completos = terminais_uf.dropna(subset=[\"Origem\", \"Destino\"])\n",
        "mesma_uf = terminais_completos[\"Origem\"].eq(terminais_completos[\"Destino\"])\n",
        "resumo_conexoes = pd.DataFrame({\n",
        "    \"Terminais\": [\"Na mesma UF\", \"Em UFs diferentes\"],\n",
        "    \"Linhas\": [int(mesma_uf.sum()), int((~mesma_uf).sum())],\n",
        "})\n",
        "resumo_conexoes[\"Percentual (%)\"] = (100 * resumo_conexoes[\"Linhas\"] / len(terminais_completos)).round(1)\n",
        "print(f\"Linhas distintas: {resultado_4['ID da linha'].nunique()}\")\n",
        "print(f\"Subestações distintas: {resultado_4['ID da subestação'].nunique()}\")\n",
        "print(f\"Linhas com as duas UFs informadas: {len(terminais_completos)}\")\n",
        "display(resumo_conexoes)\n"
      ]
    },
